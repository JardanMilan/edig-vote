# Másold .env néven, és töltsd ki. A .env NE kerüljön a repóba!

PORT=3000
DB_PATH=./data/szavazas.db

# Google OAuth kliens (Web application) azonosítója – lásd docs/RENDSZERGAZDA.md
GOOGLE_CLIENT_ID=
ALLOWED_DOMAIN=edig.hu

# Admin felület: vesszővel elválasztott @edig.hu címek
ADMIN_EMAILS=

# Hosszú, véletlen értékek, pl.: openssl rand -hex 32
APP_SECRET=
KIOSK_KEY=

# Jelenléti kód: váltás gyakorisága (mp), hány korábbi kódot fogadunk még el,
# és sikeres kód után mennyi idő van szavazni (mp)
CODE_WINDOW_SEC=30
CODE_GRACE_WINDOWS=1
PRESENCE_TTL_SEC=300
# QR-beolvasás után ennyi ideje van a diáknak belépni (mp)
SCAN_TTL_SEC=180

# Opcionális: csak ezekről az IP-kről lehet szavazni (pl. az iskola nyilvános IP-je)
# ALLOWED_IPS=81.183.10.7,81.183.10.0/24

# Ha reverse proxy (Caddy/nginx) mögött fut ugyanazon a gépen:
# TRUST_PROXY=loopback

# CSAK FEJLESZTÉSHEZ! Google nélküli belépés. Élesben tilos.
# DEV_LOGIN=1
# COOKIE_SECURE=0
